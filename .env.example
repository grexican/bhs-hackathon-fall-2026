# Copy to .env. Never commit .env. Apps inside this repo find this file automatically.

# AI (kit/ai). Paste the OpenRouter key the organizers gave you. No key = simulator mode.
OPENROUTER_API_KEY=
# AI_PROVIDER=sim              # force the offline simulator even when a key exists

# Swap models per tier without touching code (ids from openrouter.ai/models).
# Defaults are the cheap tiers below. Start lite; it's a prototype.
# MODEL_LITE=qwen/qwen3.7-flash
# MODEL_FAST=openai/gpt-6-luna
# MODEL_SMART=qwen/qwen3.7-plus
# MODEL_THINKING=deepseek/deepseek-v4-pro-0813
# MODEL_VISION=qwen/qwen3.8-omni-flash
# MODEL_IMAGE=google/gemini-3.1-flash-lite-image
# Move up only with an organizer, after the cheap tier visibly failed twice:
# MODEL_SMART=anthropic/claude-sonnet-5.5
# MODEL_THINKING=anthropic/claude-opus-5.5
# MODEL_AUTO=typesafe/jev-router
# MODEL_DECIDE=~typesafe/jev-latest

# Providers: sim (default) or real. Real ones need their keys below.
# PROVIDER_MESSAGING=sim
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
