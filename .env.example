# Copy to .env. Never commit .env. Apps inside this repo find this file automatically.

# AI (kit/ai). Without a key, the AI kit runs in simulator mode.
OPENROUTER_API_KEY=
# AI_PROVIDER=sim              # force the offline simulator even when a key exists

# Swap models per tier without touching code (ids from openrouter.ai/models)
# MODEL_LITE=openai/gpt-6-luna
# MODEL_FAST=openai/gpt-oss-120b
# MODEL_SMART=anthropic/claude-sonnet-5
# MODEL_THINKING=anthropic/claude-opus-5.5
# MODEL_VISION=google/gemini-3.8-flash
# MODEL_IMAGE=google/gemini-3.1-flash-image
# MODEL_AUTO=typesafe/jev-router
# MODEL_DECIDE=~typesafe/jev-latest

# Providers: sim (default) or real. Real ones need their keys below.
# PROVIDER_MESSAGING=sim
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
